---
import Base from "@/layouts/Base.astro";
import { getCollection } from "astro:content";
import { GitHubLogoIcon } from "@radix-ui/react-icons";

const latestPosts = await getCollection("blog").then((allPosts) =>
  allPosts
    .filter((post) => post.data.public)
    .toSorted((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .slice(0, 3),
);
---

<Base title="sca.run homepage">
  <main class="flex min-h-[calc(100vh-88px)] flex-col items-center justify-center p-4">
    <div class="flex flex-col items-center justify-center gap-8">
      <a href="/blog" class="text-6xl font-bold hover:underline">Blog &RightArrow;</a>
      <div class="flex max-w-48 flex-col gap-1">
        <em class="mb-1">Recent posts:</em>
        {
          latestPosts.map((p) => (
            <a href={`/blog/${p.id}`} class="truncate hover:underline">
              {p.data.title}
            </a>
          ))
        }
      </div>
    </div>
    <span class="mt-32">
      This site is run by <a href="/resume" class="hover:underline">Sharath</a>.
      <a
        target="_blank"
        rel="noopener noreferrer"
        href="//github.com/tnfssc/sca.run"
        class="mt-2 flex items-center gap-2 hover:underline"
      >
        Source code available here <GitHubLogoIcon className="inline-block size-4" />
      </a>
    </span>
  </main>
</Base>
